+async function waitForRenewal(rowId: string, previous: DateTime | null): Promise<DateTime> {
+  if (previous === null) throw new Error('Missing original lease expiry')
+  for (let attempt = 0; attempt < 100; attempt++) {
+    const expiry = await readLeaseExpiresAt(rowId)
+    if (expiry && expiry.toMillis() > previous.toMillis()) return expiry
+    await new Promise((done) => setTimeout(done, 5))
+  }
+  throw new Error('Heartbeat did not renew its real database row')
 }

