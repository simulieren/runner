+  /**
+   * `purgeUser` for a chunk of users in one transaction, with each statement
+   * matching every id in the chunk instead of one round trip per user.
+   */
+  private async purgeUsers(users: { id: string; email: string }[]): Promise<void> {
+    const ids = users.map((user) => user.id)
+    const hashes = users.map((user) => hashEmail(user.email))
+    const trx = await db.transaction()
+    try {
+      await trx.rawQuery(
+        `UPDATE admin_action_logs AS l
+           SET deleted_user_label = 'deleted-user',
+               deleted_user_email = COALESCE(l.deleted_user_email, v.email_hash),
+               admin_user_id = NULL
+          FROM unnest(?::uuid[], ?::text[]) AS v(user_id, email_hash)
+         WHERE l.admin_user_id = v.user_id`,
+        [ids, hashes]
+      )
+      await trx.from('system_setting_audits').whereIn('changed_by_user_id', ids).update({
+        deleted_user_label: 'deleted-user',
+        changed_by_user_id: null,
+      })
+      await trx.from('ip_bans').whereIn('banned_by_id', ids).update({ banned_by_id: null })
+      await trx.from('user_bans').whereIn('banned_by_id', ids).update({ banned_by_id: null })
+      await trx.from('attachments').whereIn('uploaded_by', ids).update({ uploaded_by: null })
+      await trx.from('user_engagement_events').whereIn('user_id', ids).delete()
+      // Per row this is the per-user condition: the creator is purged and is not the owner.
+      await trx.rawQuery(
+        `UPDATE documents SET created_by_id = owner_user_id
+          WHERE created_by_id = any(?::uuid[]) AND owner_user_id != created_by_id`,
+        [ids]
+      )
+      await trx.from('documents').whereIn('owner_user_id', ids).delete()
+      await trx.from('ai_jobs').whereIn('requested_by_user_id', ids).delete()
+      await trx.from('ai_jobs').whereIn('created_by', ids).update({ created_by: null })
+      await trx.from('ai_jobs').whereIn('updated_by', ids).update({ updated_by: null })
+      await trx.from('ai_presets').whereIn('created_by', ids).update({ created_by: null })
+      await trx.from('ai_presets').whereIn('updated_by', ids).update({ updated_by: null })
+      await AssistantRecordPurgeService.purgeUsers(trx, ids)
+      await trx.from('users').whereIn('id', ids).delete()
+      await trx.commit()
+    } catch (error) {
+      await trx.rollback()
+      throw error
+    }
+  }
